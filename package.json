{
  "name": "oasis",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:web": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts && esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/server.js --packages=external",
    "start": "node dist/server.js",
    "test": "tsx --test src/playlist.test.ts src/modules/events/catalog.test.ts"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.2.9",
    "@fontsource/nunito": "^5.2.7",
    "@hono/node-server": "^1.19.9",
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "@vitejs/plugin-react": "^5.1.0",
    "dexie": "^4.2.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.11",
    "hono": "^4.10.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.4",
    "three": "^0.180.0",
    "vite": "^7.1.12",
    "vite-plugin-pwa": "^1.1.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
