# Copia este archivo a .env y pega ahí tus llaves.
# .env queda solo en tu máquina: está en .gitignore y no se sube al repositorio.
# No pegues estos valores en el chat ni en el código.

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Id o URL pública de la playlist. No son secretos.
SPOTIFY_PLAYLIST_ID=
YOUTUBE_PLAYLIST_ID=

# Opcionales. Si faltan, Oasis sigue funcionando sin ellos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VITE_GOOGLE_CLIENT_ID=

# Postgres de operaciones anónimas. Vacío: el diario sigue en el navegador
# y la sala muestra la semilla sintética. No pongas aquí datos de una persona.
DATABASE_URL=

# Clave de la sala de colegio. Vacía: no se puede publicar ni ver la base en vivo.
ADMIN_PASSWORD=
